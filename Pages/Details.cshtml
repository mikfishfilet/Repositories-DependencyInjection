
@page
@model MicroBlog.Pages.DetailsModel

@{
    ViewData["Title"] = Model.Post?.Title;
}

<div class="container mt-4">
    @if (Model.Post != null)
    {
        <article>
            <h1>@Model.Post.Title</h1>

            <p class="text-muted">
                Posted:
                @Model.Post.CreatedUtc.ToLocalTime()
                    .ToString("f")
            </p>

            <hr />

            <div class="post-body">
                @Model.Post.Body
            </div>
        </article>
    }

    <a asp-page="/Index"
       class="btn btn-secondary mt-4">
        Back to Posts
    </a>
</div>