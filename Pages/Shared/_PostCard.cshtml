
@model MicroBlog.Models.Post

<div class="card h-100 shadow-sm">
    <div class="card-body">
        <h5 class="card-title">
            @Model.Title
        </h5>

        <p class="text-muted small">
            Posted:
            @Model.CreatedUtc.ToLocalTime()
                .ToString("g")
        </p>

        <p class="card-text">
            @(Model.Body.Length > 150
                ? Model.Body.Substring(0, 150) + "..."
                : Model.Body)
        </p>

        <a asp-page="/Details"
           asp-route-id="@Model.Id"
           class="btn btn-outline-primary">
            Read More
        </a>
    </div>
</div>